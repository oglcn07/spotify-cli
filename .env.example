# Optional alternative to `spotify configure`.
# This example file is NOT loaded automatically. Export variables in your shell.
# Client ID is public application metadata; no Client Secret is required (PKCE).
SPOTIFY_CLIENT_ID=your_32_character_spotify_web_api_client_id
# Optional paid Musixmatch API access; leave unset to use free/local lyrics.
# MUSIXMATCH_API_KEY=your_own_key
